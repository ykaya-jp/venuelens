/// P2.D Track B-1 — per-device Web Push subscription. One user can have
/// multiple devices (laptop browser + phone PWA) so this is a 1-to-many
/// off `User` rather than a Json column on NotificationPreference.
///
/// `endpoint` is the push service URL FCM / APNs / etc. assigns; it's
/// stable per (browser install, app origin) and naturally unique. We
/// upsert on it so the same browser re-subscribing (after reload /
/// permission re-grant) doesn't create duplicates.
///
/// `p256dh` + `auth` are the symmetric crypto keys the push service
/// hands back at subscribe time; web-push needs both to encrypt the
/// outbound payload. They're not secrets per se (only useful when
/// combined with the recipient's specific endpoint), but treat them as
/// per-user data and never log raw values.
///
/// Lifecycle:
///   - upsert by endpoint when the browser's `pushManager.subscribe()`
///     resolves
///   - delete by endpoint when the browser's
///     `subscription.unsubscribe()` is called or when web-push reports
///     410 Gone (the user disabled the OS-level notification)
///   - GDPR cascade: deletes when the User is deleted
///
/// Legacy: `NotificationPreference.pushSubscription` (Json) was the
/// pre-B-1 single-device store. Left in place to avoid a destructive
/// migration; the dispatcher (B-2) reads exclusively from this table
/// going forward.
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Truncated User-Agent string captured at subscribe time so the
  /// settings UI can show "MacBook (Chrome)" etc. for multi-device
  /// users — sized to 256 chars (same cap as audit_logs).
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Track B-2 visit-reminder dispatcher dedupe gate.
///
/// One row per (userId × visitId × phase × scheduledDateKey). Created
/// with prisma.create + P2002 catch so two concurrent cron invocations
/// can't double-send — DB enforces the uniqueness atomically, no
/// count-then-create race.
///
/// `scheduledDateKey` is the JST `YYYY-MM-DD` of the visit at the
/// moment of send. Including it (instead of just `(userId, visitId,
/// phase)`) is the designer-warned-about scheduledAt-change
/// invalidation: if the user reschedules to a different day, the new
/// send produces a different key and the unique constraint doesn't
/// suppress it. Same-day time tweaks reuse the key (no spam).
///
/// Retention: rows older than DATA_RETENTION_DAYS are swept by the
/// existing /api/cron/data-retention-sweep — this table joins the
/// retention horizon so we don't accumulate unbounded dedupe history.
model VisitReminderSent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  visitId          String   @map("visit_id") @db.Uuid
  /// "day_before" | "morning_of" | "way_home" — matches VisitReminderPhase.
  phase            String
  /// JST YYYY-MM-DD of the visit at send time. See model docstring.
  scheduledDateKey String   @map("scheduled_date_key")
  sentAt           DateTime @default(now()) @map("sent_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([userId, visitId, phase, scheduledDateKey])
  /// Retention sweep filter — `sent_at < now() - DATA_RETENTION_DAYS`.
  @@index([sentAt])
  /// Foreign-key driven cleanup when a Visit is hard-deleted.
  @@index([visitId])
  @@map("visit_reminder_sent")
}

/// Phase 3 Level 3 wave 2 — couple-activity push throttle.
///
/// One row per (recipient × kind × scope × hour bucket). Created with
/// prisma.create + P2002 catch so concurrent broadcasts from the
/// Realtime layer can't double-notify the partner — DB enforces the
/// uniqueness atomically (same race-safety contract as
/// VisitReminderSent).
///
/// `hourBucket` is `floor(now().getTime() / (60 * 60 * 1000))` —
/// including it in the unique key gives an automatic 1h cool-down
/// per (kind, scope): a second event in the same hour P2002s and is
/// silently skipped, the next hour rolls a fresh bucket and the
/// next event sends. Same shape that protected B-2 against
/// scheduledAt-change invalidation, applied here for time-window
/// invalidation instead of date-change invalidation.
///
/// Retention: rows older than DATA_RETENTION_DAYS are pruned by the
/// existing /api/cron/data-retention-sweep.
model PushSendLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  /// "partner_rating_added" | "partner_note_added" |
  /// "decision_saved" | "wedding_date_set" — matches RealtimePushEvent
  /// in src/lib/push/realtime-copy.ts.
  kind            String
  /// venueId | projectId | visitId depending on kind. Stringly-typed
  /// (not a FK) so a hard delete of the scope row doesn't break the
  /// throttle log retention sweep.
  scopeId         String   @map("scope_id")
  /// Unix epoch hour of send — `floor(sentAt / 3600s)`. See model
  /// docstring for why this is part of the unique key.
  hourBucket      Int      @map("hour_bucket")
  sentAt          DateTime @default(now()) @map("sent_at")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([recipientUserId, kind, scopeId, hourBucket])
  /// Retention sweep filter — `sent_at < now() - DATA_RETENTION_DAYS`.
  @@index([sentAt])
  @@map("push_send_logs")
}

/// Track C-1 family read-only share link.
///
/// Public token grants ANY visitor (no auth) read-only access to a
/// project's Decision view. To bound the blast radius:
///   - 32-byte crypto-random token (256 bits, hex-encoded → 64 chars).
///     Brute force is not feasible; URL leak is the realistic threat.
///   - `expiresAt` defaults to 30 days from creation; the dispatcher
///     rejects past-dated rows so a leaked URL has a hard ceiling.
///   - `revokedAt` lets the owner kill a link instantly without waiting
///     for natural expiry. Public route checks both gates.
///   - At most one *active* (unrevoked + unexpired) link per project at
///     a time — issuing a new one revokes any prior live link to keep
///     the surface attackers can probe minimal.
///
/// Audit:
///   - `family.invitation.created` on issue
///   - `family.invitation.viewed`  on each consume (rate-limited per IP)
///   - `family.invitation.revoked` on owner revoke
///
/// Telemetry:
///   - `viewCount` is a per-link rolling counter for the owner UI.
///   - `lastViewedAt` shows "最後にXさんが見ました" affordance.
///   - `lastViewedIpHash` (sha256-first-16 of redacted /24) lets the
///     owner spot "誰かが共有した URL を別の人が叩いている" without
///     storing raw IPs.
model FamilyInvitation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  /// 64-char hex string (32 bytes). Unique = lookup index for /family/[token].
  token            String    @unique
  createdBy        String    @map("created_by") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedBy        String?   @map("revoked_by") @db.Uuid
  viewCount        Int       @default(0) @map("view_count")
  lastViewedAt     DateTime? @map("last_viewed_at")
  /// sha256(redactedIp).slice(0,16). Owner-facing UI only — never echoed
  /// to the public route. Null until the first successful view.
  lastViewedIpHash String?   @map("last_viewed_ip_hash")
  createdAt        DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation("FamilyInvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  revoker User?   @relation("FamilyInvitationRevoker", fields: [revokedBy], references: [id])

  /// Owner-facing list — "this project's links, newest first".
  @@index([projectId, createdAt])
  /// Retention sweep — purge expired+revoked links older than horizon.
  @@index([expiresAt])
  @@map("family_invitations")
}

model NotificationPreference {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                @unique @map("user_id") @db.Uuid
  frequency             NotificationFrequency @default(auto)
  pushEnabled           Boolean               @default(false) @map("push_enabled")
  emailEnabled          Boolean               @default(true) @map("email_enabled")
  pushSubscription      Json?                 @map("push_subscription")
  /// P2.D Resend bounce / complaint suppression metadata.
  ///
  /// `emailSuppressedReason` records WHY the email leg was disabled so
  /// the daily retry cron (`/api/cron/email-suppression-retry`) can
  /// distinguish:
  ///
  ///   - `hard_bounce` — invalid address / permanent failure → never
  ///     auto-retry (user must update email via /mypage)
  ///   - `complained` — user marked as spam → never auto-retry
  ///     (deliverability + ESP relationship priority)
  ///   - `soft_bounce` — mailbox full / rate limit / DNS hiccup →
  ///     auto-retry after 7 days
  ///   - `manual` — user toggled it off in /mypage settings UI →
  ///     never auto-retry (the user is the SoT)
  ///   - null — emailEnabled was never auto-suppressed (default)
  ///
  /// `emailSuppressedAt` is set whenever a suppression is recorded so
  /// the retry cron can compare against `now - 7 days`.
  emailSuppressedReason String?               @map("email_suppressed_reason")
  emailSuppressedAt     DateTime?             @map("email_suppressed_at")
  /// Track B-3 per-timing visit-reminder toggles. Each maps 1:1 to a
  /// VisitReminderPhase consumed by the cron dispatcher: a `false`
  /// value silently skips that phase for this user without recording
  /// a VisitReminderSent dedupe row, so re-enabling later still fires
  /// future reminders. Defaults are `true` so the B-2 cron behaviour
  /// stays intact for existing rows after the additive migration.
  remindersDayBefore    Boolean               @default(true) @map("reminders_day_before")
  remindersMorningOf    Boolean               @default(true) @map("reminders_morning_of")
  remindersWayHome      Boolean               @default(true) @map("reminders_way_home")
  /// Phase 3 Level 3 wave 2 — partner activity push toggles. Each maps
  /// 1:1 to a `RealtimePushEvent` consumed by `dispatchRealtimeEvent`:
  /// false silently skips that event WITHOUT recording a PushSendLog
  /// throttle row, so re-enabling later still fires the next event.
  /// Defaults are true so the wave-1 Realtime broadcasts can ship
  /// notifications without an opt-in step.
  notifyPartnerRating   Boolean               @default(true) @map("notify_partner_rating")
  notifyPartnerNote     Boolean               @default(true) @map("notify_partner_note")
  notifyDecisionSaved   Boolean               @default(true) @map("notify_decision_saved")
  notifyWeddingDateSet  Boolean               @default(true) @map("notify_wedding_date_set")
  /// Audit P1-20 / P1-21: partner venue add / delete push toggles. Paired
  /// 1:1 with partner_venue_added / partner_venue_deleted Realtime push
  /// kinds. Defaults true so the first roll-out doesn't require an extra
  /// opt-in step; users disable per-channel from /mypage like other
  /// notify_* flags.
  notifyPartnerVenueAdded   Boolean           @default(true) @map("notify_partner_venue_added")
  notifyPartnerVenueDeleted Boolean           @default(true) @map("notify_partner_venue_deleted")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index supports the daily retry cron's
  // `where emailSuppressedReason='soft_bounce' AND emailSuppressedAt < cutoff`
  // scan without a full table sweep.
  @@index([emailSuppressedReason, emailSuppressedAt])
  @@map("notification_preferences")
}

model ProjectChecklist {
  id        String   @id @default(cuid())
  projectId String   @map("project_id") @db.Uuid
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  answers VenueChecklistAnswer[]

  @@unique([projectId, itemId])
  @@index([projectId])
  @@map("project_checklists")
}

model VenueChecklistAnswer {
  id                 String   @id @default(cuid())
  projectChecklistId String   @map("project_checklist_id")
  venueId            String   @map("venue_id") @db.Uuid
  /// Author of this answer. Couples evaluate venues individually; spouses
  /// keep separate rows per checklist item so "妻 4 / 夫 3" can be compared
  /// side-by-side without one overwriting the other. Historical rows are
  /// backfilled to the project owner in the same migration that adds this
  /// column.
  userId             String   @map("user_id") @db.Uuid
  status             String?
  memo               String?
  numberValue        Decimal? @map("number_value") @db.Decimal(12, 2)
  /// User's 0.5–5.0 score for this checklist item on this venue. Null means
  /// the user hasn't graded this question yet — the aggregator (see
  /// src/lib/checklist-rating-aggregator.ts) treats null as missing rather
  /// than as a zero, so an unscored question doesn't drag the parent
  /// dimension average down. The CHECK constraint in the migration enforces
  /// the 0.5-step grid (0.5, 1.0, ..., 5.0).
  numericScore       Decimal? @map("numeric_score") @db.Decimal(2, 1)
  photoUrls          String[] @default([]) @map("photo_urls")
  updatedAt          DateTime @updatedAt @map("updated_at")

  projectChecklist ProjectChecklist @relation(fields: [projectChecklistId], references: [id], onDelete: Cascade)
  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectChecklistId, venueId, userId])
  @@index([projectChecklistId])
  @@index([projectChecklistId, userId])
  @@index([venueId])
  @@map("venue_checklist_answers")
}

/// Project-scoped custom checklist questions. Co-exists with the static
/// `CHECKLIST_PRESETS` library in src/lib/checklist-presets.ts — preset items
/// live in code (stable across projects), custom items live in the DB
/// (couple-specific, e.g. "親族控室の畳数 は何畳？"). A `ProjectChecklist.itemId`
/// can reference either a preset id (`chapel.interior.decor-style`) or a
/// CustomChecklistItem.id; lookup tries the preset map first, then this
/// table. Soft delete via `deletedAt` so existing VenueChecklistAnswer rows
/// don't become orphaned when a couple removes a custom question — they're
/// hidden in UI but the historical answer is recoverable.
model CustomChecklistItem {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id") @db.Uuid
  category    String
  subcategory String?
  question    String
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category, deletedAt])
  @@map("custom_checklist_items")
}

model Notification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  type                String
  title               String
  body                String
  href                String?
  read                Boolean   @default(false)
  readAt              DateTime? @map("read_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  /// P2.D Resend webhook: the message id returned by Resend when the
  /// notification's email was dispatched. Null when the notification was
  /// in-app only (no email leg) or when the in-app row predates this
  /// column. Indexed because the webhook handler looks up notifications
  /// by this id when an event arrives.
  resendMessageId     String?   @map("resend_message_id")
  /// Latest Resend delivery status if known. Stringly-typed (rather than
  /// an enum) so adding new event types (`email.scheduled`,
  /// `email.delayed`, etc.) doesn't require a migration. App-level
  /// constants in `src/lib/email/delivery.ts` define the legal values
  /// (`sent` / `delivered` / `delivery_delayed` / `bounced` /
  /// `complained` / `opened` / `clicked`).
  emailDeliveryStatus String?   @map("email_delivery_status")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([resendMessageId])
  @@map("notifications")
}

